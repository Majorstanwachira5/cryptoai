# CRYPTOBULL.AI Environment Configuration
PORT=3300
NEXT_PUBLIC_APP_NAME=CRYPTOBULL.AI
NEXT_PUBLIC_APP_URL=http://localhost:3300
NEXT_PUBLIC_API_URL=http://localhost:3300/api

# Public Market Data Endpoints (read-only public exchange feeds)
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws
NEXT_PUBLIC_BINANCE_REST_URL=https://api.binance.com/api/v3

# Database & Cache (Configured to avoid host collisions with 5050/6379)
DATABASE_URL="postgresql://cryptobull:cryptobull_secure_pass@localhost:5433/cryptobull_db?schema=public"
REDIS_URL="redis://localhost:6381"

# Security & Session Secrets
JWT_SECRET=cryptobull_dev_super_secret_jwt_key_2026_finance_engine
NEXT_TELEMETRY_DISABLED=1
